{
  "name": "pphunt",
  "description": "Collect, preview, and export Amazon product data with care.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "verify": "tsc --noEmit && vitest run && wxt build && npm audit --omit=dev",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "check:dead-exports": "node scripts/check-dead-exports.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "26.1.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
